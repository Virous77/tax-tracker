# Replace this placeholder before generating a public domain.
APP_PASSWORD=change-me-to-a-strong-passphrase
DATA_DIR=/data
# Start as root to fix /data ownership, then immediately drop to the unprivileged node user.
RAILWAY_RUN_UID=0
# Give the web server time to shut down after SIGTERM.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=15
# Railway sets PORT automatically.

# Optional. Leave APP_SECRET empty to generate and persist /data/.session-secret.
APP_SECRET=
SOURCE_URL=https://github.com/Virous77/tax-tracker

# Optional AI recipe assistant.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional Vault auto-unlock. Anyone who can read these variables can unlock the Vault.
SECRETS_PASSPHRASE=
