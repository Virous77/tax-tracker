# pnpm dev reads these from apps/web/.env.local; Docker Compose reads .env at the repository root.
# Deploying on Railway? Use .env.railway.example.
NEXT_TELEMETRY_DISABLED=1
# Keep the default for local access. To listen on the LAN, set APP_BIND_ADDRESS
# to the LAN interface or 0.0.0.0 and configure APP_PASSWORD before starting.
APP_BIND_ADDRESS=127.0.0.1
# Host port for docker compose.
APP_PORT=3000
# Local build tag. To pull a published image once releases exist, set this to
# ghcr.io/virous77/tax-tracker:<release-tag>.
TAX_TRACKER_IMAGE=tax-tracker:local
# Give each copy its own Compose project name when running more than one.
# COMPOSE_PROJECT_NAME=tax-tracker
# Optional OCI build metadata for local Docker images.
# TAX_TRACKER_VERSION=
# TAX_TRACKER_REVISION=
# TAX_TRACKER_REPOSITORY_URL=
# Public URL for this build's corresponding source code. Empty hides the footer link.
SOURCE_URL=
# pnpm dev only. Docker always uses /data inside the container.
# DATA_DIR=./data
# Optional Docker host path override when the workspace is not shared with Docker Desktop.
# DATA_HOST_DIR=/absolute/path/to/data
# Empty leaves the application open in local mode.
APP_PASSWORD=
# Public demo only. true adds a /login warning and synthetic CSV downloads,
# and displays APP_PASSWORD unless DEMO_PASSWORD is set.
DEMO_MODE=false
# Optional public demo passphrase.
DEMO_PASSWORD=
# Optional: otherwise a private secret is generated in DATA_DIR/.session-secret.
APP_SECRET=
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=
AI_API_KEY=

# Optional auto-unlock; weaker because container environment readers can decrypt stored keys.
SECRETS_PASSPHRASE=
# Empty uses the production default. Override only for an upstream you intend to contact.
BINANCE_API_BASE=
BINANCE_DATA_BASE=
COINDCX_API_BASE=
ETHERSCAN_API_BASE=
BLOCKSCOUT_API_BASE=
ALCHEMY_API_BASE=
NODEREAL_API_BASE=
COINGECKO_API_BASE=
POLYGON_API_BASE=
FINNHUB_API_BASE=
