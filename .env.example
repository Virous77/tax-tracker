# pnpm dev reads these from apps/web/.env.local; Docker Compose reads .env at the repository root.
NEXT_TELEMETRY_DISABLED=1
# Host port for docker compose.
APP_PORT=3000
DATA_DIR=./data
# Optional Docker host path override when the workspace is not shared with Docker Desktop.
# DATA_HOST_DIR=/absolute/path/to/data
# Empty leaves the application open in local mode.
APP_PASSWORD=
# Optional: otherwise a private secret is generated in DATA_DIR/.session-secret.
APP_SECRET=
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=
AI_API_KEY=

# Optional auto-unlock; weaker because container environment readers can decrypt stored keys.
SECRETS_PASSPHRASE=
# Empty uses the production default. Override only for an upstream you intend to contact.
BINANCE_API_BASE=
BINANCE_DATA_BASE=
COINDCX_API_BASE=
ETHERSCAN_API_BASE=
BLOCKSCOUT_API_BASE=
ALCHEMY_API_BASE=
NODEREAL_API_BASE=
COINGECKO_API_BASE=
